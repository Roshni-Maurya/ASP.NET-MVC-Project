

@{
    ViewBag.Title = "Create";
}


@model EmployeeManagement.Models.Employee

<!DOCTYPE html>

<html>
<head>

    <title>Create Employee</title>

    <style>
        /* Label ki width: isse textbox ka alignment badlega */
        .form-row label {
            display: inline-block;
            width: 120px;
            font-weight: bold;
        }

        /* Textbox ki width */
        .form-row input[type="text"] {
            width: 220px;
            padding: 3px 6px;
        }

        .form-row {
            margin: 8px 0;
        }
    </style>

</head>

<body>

    <h1>ADD NEW EMPLOYEE</h1>

    <hr />

    @using (Html.BeginForm())
    {
        <div class="form-row">
            <label>Employee ID:</label>
            @Html.TextBoxFor(x => x.EmployeeId)
        </div>

        <div class="form-row">
            <label>Name:</label>
            @Html.TextBoxFor(x => x.Ename)
        </div>

        <div class="form-row">
            <label>Department:</label>
            @Html.TextBoxFor(x => x.Department)
        </div>

        <div class="form-row">
            <label>Designation:</label>
            @Html.TextBoxFor(x => x.Designation)
        </div>

        <div class="form-row">
            <label>Salary:</label>
            @Html.TextBoxFor(x => x.salary)
        </div>

        <div class="form-row">
            <label>Email:</label>
            @Html.TextBoxFor(x => x.Email)
        </div>

        <div class="form-row">
            <label></label>
            <input type="submit" value="Save Employee" />
        </div>
    }

    <br />

    @Html.ActionLink("Back to Employee List", "Index")

</body>
</html>