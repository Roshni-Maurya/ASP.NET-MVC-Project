@model EmployeeManagement.Models.Employee

@{
    ViewBag.Title = "Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Employee Details</h4>
                </div>

                <div class="card-body">
                    <p><b>Employee ID:</b> @Model.EmployeeId</p>
                    <p><b>Name:</b> @Model.Ename</p>
                    <p><b>Department:</b> @Model.Department</p>
                    <p><b>Designation:</b> @Model.Designation</p>
                    <p><b>Salary:</b> @Model.salary</p>
                    <p><b>Email:</b> @Model.Email</p>
                </div>

                <div class="card-footer text-end">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.EmployeeId },
                        new { @class = "btn btn-warning" })

                    @Html.ActionLink("Back to List", "Index", null,
                        new { @class = "btn btn-secondary" })
                </div>
            </div>

        </div>
    </div>
</div>