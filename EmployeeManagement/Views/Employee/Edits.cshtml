@model EmployeeManagement.Models.Employee

@{
    ViewBag.Title = "Edits Employee";
}

<style>
    /* Label ki width: isse textbox ka alignment badlega */
    .form-row label {
        display: inline-block;
        width: 120px;
        font-weight: bold;
    }

    /* Textbox ki width */
    .form-row input[type="text"] {
        width: 220px;
        padding: 3px 6px;
    }

    .form-row {
        margin: 8px 0;
    }
</style>

<h1>EDIT EMPLOYEE</h1>

<hr />

<!-- Submit updated information to Edit POST action -->
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <!-- Keep Employee ID during form submission -->
    @Html.HiddenFor(x => x.EmployeeId)

    <!-- Display employee ID -->
    <div class="form-row">
        <label>Employee ID:</label>
        @Html.DisplayFor(x => x.EmployeeId)
    </div>

    <!-- Editable employee fields -->
    <div class="form-row">
        <label>Name:</label>
        @Html.TextBoxFor(x => x.Ename)
    </div>

    <div class="form-row">
        <label>Department:</label>
        @Html.TextBoxFor(x => x.Department)
    </div>

    <div class="form-row">
        <label>Designation:</label>
        @Html.TextBoxFor(x => x.Designation)
    </div>

    <div class="form-row">
        <label>Salary:</label>
        @Html.TextBoxFor(x => x.salary)
    </div>

    <div class="form-row">
        <label>Email:</label>
        @Html.TextBoxFor(x => x.Email)
    </div>

    <!-- Submit updated data -->
    <div class="form-row">
        <label></label>
        <input type="submit" value="Update Employee" />
    </div>
}

<br />

@Html.ActionLink("Back to List", "Index")